{
  "name": "vppsone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typegen": "next typegen",
    "typecheck": "npm run typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:bundles": "node scripts/performance-bundles.mjs --baseline docs/evidence/smoothness-redesign.json",
    "check": "npm run typecheck && npm run lint && npm run check:theme && npm run check:port && npm run test && npm run build && npm run check:bundles",
    "seed:dev": "node scripts/seed-dev.mjs",
    "seed:timetable": "node --import ./scripts/alias-hook.mjs scripts/seed-timetable.mjs",
    "seed:scenarios": "node --import ./scripts/alias-hook.mjs scripts/seed-scenarios.mjs",
    "db:diff": "supabase db diff --schema vppsone",
    "db:link": "supabase link --project-ref wtgxcptmucjerhufzjcf",
    "db:types": "supabase gen types typescript --linked --schema vppsone",
    "dev:login": "node scripts/dev-login.mjs",
    "jobs:tokens": "node --import ./scripts/alias-hook.mjs scripts/job-tokens.mjs",
    "cutover:check": "node scripts/cutover-check.mjs",
    "smoke:roles": "node --import ./scripts/alias-hook.mjs scripts/smoke-roles.mjs --strict",
    "verify:origins": "node --import ./scripts/alias-hook.mjs scripts/verify-origins.mjs",
    "qa:seed": "node --import ./scripts/alias-hook.mjs scripts/qa-fixture.mjs seed",
    "qa:reset": "node --import ./scripts/alias-hook.mjs scripts/qa-fixture.mjs reset",
    "qa:status": "node --import ./scripts/alias-hook.mjs scripts/qa-fixture.mjs status",
    "smoke:workflows": "playwright test",
    "check:theme": "node --no-warnings scripts/check-theme-parity.mjs",
    "check:port": "node --no-warnings scripts/port-rewrite-imports.mjs --check",
    "smoke:deep": "node --import ./scripts/alias-hook.mjs scripts/deep-smoke.mjs",
    "smoke:screens": "node --import ./scripts/alias-hook.mjs scripts/smoke-screens.mjs",
    "replica:plan": "node scripts/replicate-live.mjs --plan",
    "replica:load": "node scripts/replicate-live.mjs --load",
    "test:mobile-ui": "playwright test --config tests/playwright/mobile-ui.playwright.config.ts",
    "verify:access": "node --import ./scripts/alias-hook.mjs scripts/verify-access.mjs",
    "verify:cover": "node scripts/verify-cover-command.mjs",
    "verify:outbox": "node scripts/verify-staff-outbox.mjs",
    "verify:attendance": "node scripts/verify-attendance.mjs",
    "verify:marks": "node scripts/verify-marks.mjs",
    "verify:reports": "node scripts/verify-reports.mjs",
    "verify:parent-policy": "node scripts/verify-parent-policy.mjs",
    "verify:records": "node scripts/verify-records.mjs",
    "verify:sampark-import": "node scripts/verify-sampark-import.mjs",
    "verify:photos": "node scripts/verify-photos.mjs",
    "verify:archive": "node --import ./scripts/alias-hook.mjs scripts/verify-archive.mjs",
    "verify:fee-parity": "node scripts/verify-fee-parity.mjs",
    "verify:native-recovery": "node --import ./scripts/alias-hook.mjs scripts/verify-native-recovery.mjs",
    "smoke:pool": "node scripts/smoke-pool.mjs",
    "smoke:sweep": "node scripts/smoke/sweep.mjs",
    "smoke:ready": "node --import ./scripts/alias-hook.mjs scripts/smoke/preflight.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@radix-ui/react-checkbox": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.1.14",
    "@radix-ui/react-label": "^2.1.6",
    "@radix-ui/react-slot": "^1.2.2",
    "@radix-ui/react-tabs": "^1.1.13",
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.46.0",
    "next": "16.3.5",
    "next-intl": "^4.13.4",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.7.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.5.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "critters": "^0.0.23",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
