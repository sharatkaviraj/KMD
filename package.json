{
  "name": "vppsone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typegen": "next typegen",
    "typecheck": "npm run typegen && tsc --noEmit",
    "test": "vitest run",
    "ai:eval": "node --conditions=react-server --import ./scripts/alias-hook.mjs scripts/ai-eval.mjs",
    "ai:fixtures": "node scripts/make-ai-eval-fixtures.mjs",
    "ai:voice-fixtures": "node scripts/make-ai-voice-fixtures.mjs",
