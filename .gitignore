# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

# playwright
/test-results/
/playwright-report/
/playwright-report.json
/blob-report/
/.playwright/
.claude/worktrees/

# design fidelity fixture dep cache
.vite-design/
.vite-polish/

# phone-suite evidence and Vite fixture builds
/.test-artifacts/
/tests/*/dist/

# Smoke Lab agent kits hold live passes; never commit them.
smoke-kit-*.json

# Smoke Lab run working files (kit holds passes)
.smoke-run/
!.env.example

# CI-only caches and shard failure copies (scripts/ci/playwright-shard.sh)
/.cache/
/.shard-failures/
