# VPPS One — local environment template. No secret or real credential here:
# only names, safe local defaults and public placeholders.
# Copy to .env.local and fill in from the owner's vault. Never commit .env.local.
# Full inventory (every name, who reads it, where the value comes from):
#   docs/cutover/ENV-INVENTORY.md
#
# BOUNDARY: One has one database, wtgxcptmucjerhufzjcf, and it is PRODUCTION
# (CLAUDE.md rule 3). Local `next dev` and Preview are "confined" by
# src/platform/deployment/confinement.ts: every user is treated as a test
# account and fee writes are limited to TEST-session students. Only
# VERCEL_ENV=production lifts that — NEVER set VERCEL_ENV here (an env file
# pulled from Vercel's production environment may contain it; remove it).
# Keep VPPSONE_ENV=dev and leave APP_MODE unset.
# The Fees live database vgqyilgstjvgohrsiwkb is never a target from here.

# Required for `npm run dev` / `npm run build`
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SCHOOL_NAME=Shri Veer Patta Senior Secondary School
NEXT_PUBLIC_SITE_URL=http://localhost:3000
VPPSONE_ENV=dev

# Server-only. Needed by server actions, jobs and most scripts/*. Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Fees bridge (Fees is the financial authority). Leave disabled locally unless
# you are deliberately testing reads against a Fees deployment; writes are
# refused on confined deployments regardless.
FEES_BRIDGE_ENABLED=false
FEES_BRIDGE_WRITES_ENABLED=false
FEES_BRIDGE_OFFICE_READS=false
FEES_BRIDGE_ORIGIN=
FEES_BRIDGE_KEY=

# Optional: AI providers (paid API calls — leave empty unless the owner agreed)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional: local theme-parity check (`npm run check:theme`) — path to a schoolfees checkout
SCHOOLFEES_REPO=
